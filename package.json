{
  "name": "pr-aging-scraper",
  "version": "1.0.0",
  "description": "PR Reviews Aging Scraper - Evidence-based PR accountability and health intelligence",
  "private": true,
  "scripts": {
    "install:all": "cd server && npm install && cd ../client && npm install",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "cd client && npm run build",
    "migrate": "cd server && npx knex migrate:latest",
    "migrate:rollback": "cd server && npx knex migrate:rollback",
    "test": "cd server && npm test",
    "start": "cd server && npm start"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}

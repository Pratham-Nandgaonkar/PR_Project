# ===========================================
# PR Aging Scraper - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values

# PostgreSQL Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pr_aging_scraper

# Server
PORT=3001
NODE_ENV=development

# GitHub (Optional - increases API rate limit from 60 to 5000 req/hour)
# Create at: https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=

# Sync Schedule (cron expression - default: every 6 hours)
SYNC_CRON=0 */6 * * *

# PR Fetch Limit (max PRs to fetch per sync, e.g. 100, 500)
PR_FETCH_LIMIT=100

# Logging
LOG_LEVEL=info
